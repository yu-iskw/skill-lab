{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yu-iskw/skill-lab/docs/contracts/schemas/evaluation-result.schema.json",
  "title": "Skill Lab Evaluation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "skill_name",
    "overall_score",
    "hard_gates_passed",
    "criteria",
    "selected_checkpoint",
    "stop_reason"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "run_id": { "type": "string", "minLength": 1 },
    "skill_name": { "$ref": "common.schema.json#/$defs/skillName" },
    "overall_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "hard_gates_passed": { "type": "boolean" },
    "criteria": {
      "type": "array",
      "items": { "$ref": "#/$defs/criterionResult" }
    },
    "selected_checkpoint": {
      "type": ["string", "null"]
    },
    "stop_reason": { "$ref": "common.schema.json#/$defs/stopReason" },
    "remaining_human_review_points": {
      "type": "array",
      "items": { "type": "string" }
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "type": ["string", "null"] },
        "prompt_version": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "criterionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "expected",
        "observed",
        "passed",
        "score",
        "evidence",
        "severity"
      ],
      "properties": {
        "criterion_id": { "type": "string", "minLength": 1 },
        "expected": { "type": "string" },
        "observed": { "type": "string" },
        "passed": { "type": "boolean" },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceItem" }
        },
        "severity": {
          "type": "string",
          "enum": ["hard", "quality"]
        },
        "likely_cause": { "type": ["string", "null"] },
        "minimal_fix": { "type": ["string", "null"] },
        "retest_method": { "type": ["string", "null"] }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reference"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["command", "report", "file", "trace", "static"]
        },
        "reference": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" }
      }
    }
  }
}
