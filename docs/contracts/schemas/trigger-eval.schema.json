{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yu-iskw/skill-lab/docs/contracts/schemas/trigger-eval.schema.json",
  "title": "Skill Lab Trigger Eval Suite (post-MVP; frozen for forward compatibility)",
  "description": "Not consumed by MVP create/evaluate workflows. Reserved for improve/diagnose-trigger.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_name", "cases"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "skill_name": { "$ref": "common.schema.json#/$defs/skillName" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/triggerCase" }
    }
  },
  "$defs": {
    "triggerCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "expected", "split"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/caseId" },
        "prompt": { "type": "string", "minLength": 1 },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["should_trigger"],
          "properties": {
            "should_trigger": { "type": "boolean" },
            "target_skill": { "$ref": "common.schema.json#/$defs/skillName" }
          }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "split": { "$ref": "common.schema.json#/$defs/split" },
        "rationale": { "type": "string" }
      }
    }
  }
}
