{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yu-iskw/skill-lab/docs/contracts/schemas/trigger-eval.schema.json",
  "title": "Skill Lab Trigger Eval Suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_name", "cases"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "skill_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/triggerCase" }
    }
  },
  "$defs": {
    "triggerCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "expected", "split"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "prompt": { "type": "string", "minLength": 1 },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["should_trigger"],
          "properties": {
            "should_trigger": { "type": "boolean" },
            "target_skill": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "split": {
          "type": "string",
          "enum": ["train", "validation", "held-out"]
        },
        "rationale": { "type": "string" }
      }
    }
  }
}
