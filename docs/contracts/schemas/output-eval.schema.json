{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yu-iskw/skill-lab/docs/contracts/schemas/output-eval.schema.json",
  "title": "Skill Lab Output Eval Suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_name", "cases"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "skill_name": { "$ref": "common.schema.json#/$defs/skillName" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/outputCase" }
    }
  },
  "$defs": {
    "outputCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "assertions", "split"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/caseId" },
        "prompt": { "type": "string", "minLength": 1 },
        "input_files": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1 }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": { "$ref": "#/$defs/assertion" }
        },
        "human_review_points": {
          "type": "array",
          "items": { "type": "string" }
        },
        "split": { "$ref": "common.schema.json#/$defs/split" }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "severity"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/caseId" },
        "type": {
          "type": "string",
          "enum": [
            "json-schema",
            "static",
            "llm-rubric",
            "dangerous-script"
          ],
          "description": "MVP types only. command/trace deferred until execution adapters exist."
        },
        "severity": {
          "type": "string",
          "enum": ["hard", "quality"]
        },
        "expected": {
          "description": "For json-schema, prefer a relative path to a schema file (compile once by path/hash). Do not embed full schema JSON as a string.",
          "type": "string"
        },
        "minimum_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "dangerous-script" } },
            "required": ["type"]
          },
          "then": {
            "properties": { "severity": { "const": "hard" } }
          }
        }
      ]
    }
  }
}
