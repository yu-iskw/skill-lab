{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yu-iskw/skill-lab/docs/contracts/schemas/output-eval.schema.json",
  "title": "Skill Lab Output Eval Suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_name", "cases"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "skill_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/outputCase" }
    }
  },
  "$defs": {
    "outputCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "assertions", "split"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "prompt": { "type": "string", "minLength": 1 },
        "input_files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assertion" }
        },
        "human_review_points": {
          "type": "array",
          "items": { "type": "string" }
        },
        "split": {
          "type": "string",
          "enum": ["train", "validation", "held-out"]
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "severity"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "json-schema",
            "static",
            "command",
            "trace",
            "llm-rubric",
            "dangerous-script"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["hard", "quality"]
        },
        "expected": { "type": "string" },
        "minimum_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
