# Validate eval suites and aggregate evaluation criterion results.
set -euo pipefail

script_dir="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck source=../lib/common.sh
source "${script_dir}/../lib/common.sh"

skill_lab_require_jq

usage() {
	cat <<'EOF'
Usage:
  skill-lab-eval --validate-only <skill-dir>
  skill-lab-eval --aggregate <criteria.json> [--out <result.json>]

--validate-only   Validate trigger/output eval JSON structure for a skill.
--aggregate       Aggregate criterion results into an evaluation-result object.
                  Hard-gate failures force hard_gates_passed=false regardless of average score.
EOF
}

mode=""
skill_dir=""
criteria_path=""
out_path=""

while [[ $# -gt 0 ]]; do
	case "$1" in
		--validate-only)
			mode=validate
			shift
			skill_dir="${1:-}"
			[[ -n ${skill_dir} ]] || skill_lab_die "--validate-only requires <skill-dir>"
			shift
			;;
		--aggregate)
			mode=aggregate
			shift
			criteria_path="${1:-}"
			[[ -n ${criteria_path} ]] || skill_lab_die "--aggregate requires <criteria.json>"
			shift
			;;
		--out)
			shift
			out_path="${1:-}"
			[[ -n ${out_path} ]] || skill_lab_die "--out requires a path"
			shift
			;;
		-h | --help)
			usage
			exit 0
			;;
		*)
			skill_lab_die "unknown argument: $1"
			;;
	esac
done

[[ -n ${mode} ]] || {
	usage >&2
	exit 2
}

cases_expr='(if type=="array" then . else .cases end)'

validate_skill_evals() {
	local dir="$1"
	[[ -d ${dir} ]] || skill_lab_die "not a directory: ${dir}"
	dir="$(CDPATH='' cd -- "${dir}" && pwd)"

	local errors=0
	local report='[]'

	check_file() {
		local path="$1"
		local kind="$2"
		if [[ ! -f ${path} ]]; then
			return 0
		fi
		if ! jq -e . "${path}" >/dev/null 2>&1; then
			report="$(jq -nc --arg path "${path}" --arg kind "${kind}" --arg msg "invalid JSON" \
				'{path:$path, kind:$kind, ok:false, message:$msg}' | jq -s --argjson acc "${report}" '$acc + .')"
			errors=$((errors + 1))
			return
		fi

		local ok=true
		local msg="ok"
		if ! jq -e "${cases_expr} | type == \"array\" and length >= 1" "${path}" >/dev/null 2>&1; then
			ok=false
			msg="cases array required"
			errors=$((errors + 1))
		elif [[ ${kind} == trigger ]]; then
			if ! jq -e "${cases_expr} | all(has(\"id\") and has(\"prompt\") and (.expected.should_trigger|type==\"boolean\") and has(\"tags\") and has(\"split\") and has(\"rationale\"))" "${path}" >/dev/null 2>&1; then
				ok=false
				msg="trigger cases missing required fields"
				errors=$((errors + 1))
			fi
		elif [[ ${kind} == output ]]; then
			if ! jq -e "${cases_expr} | all(has(\"id\") and has(\"prompt\") and (.assertions|type==\"array\" and length>=1) and has(\"input_files\") and has(\"human_review_points\") and has(\"split\"))" "${path}" >/dev/null 2>&1; then
				ok=false
				msg="output cases missing required fields"
				errors=$((errors + 1))
			fi
		fi

		report="$(jq -nc --arg path "${path}" --arg kind "${kind}" --argjson ok "${ok}" --arg msg "${msg}" \
			'{path:$path, kind:$kind, ok:$ok, message:$msg}' | jq -s --argjson acc "${report}" '$acc + .')"
	}

	check_file "${dir}/evals/trigger-evals.json" trigger
	check_file "${dir}/evals/output-evals.json" output

	jq -nc --arg skill_dir "${dir}" --argjson passed "$((errors == 0))" --argjson error_count "${errors}" --argjson checks "${report}" \
		'{skill_dir:$skill_dir, passed:($passed == 1), error_count:$error_count, checks:$checks}'

	((errors == 0))
}

aggregate_criteria() {
	local path="$1"
	skill_lab_require_file "${path}"
	skill_lab_json_ok "${path}"

	local result
	result="$(
		jq -c '
			(if type=="array" then {criteria:.} else . end) as $in
			| ($in.criteria // []) as $criteria
			| ($criteria | length) as $n
			| (if $n == 0 then 0 else (($criteria | map(.score // 0) | add) / $n) end) as $avg
			| (($criteria | map(select((.severity == "hard") and (.passed == false))) | length) == 0) as $hard_ok
			| {
					run_id: ($in.run_id // "run-local"),
					skill_name: ($in.skill_name // "unknown"),
					overall_score: $avg,
					hard_gates_passed: $hard_ok,
					criteria: $criteria,
					best_checkpoint: ($in.best_checkpoint // null),
					stop_reason: (if $hard_ok then ($in.stop_reason // "passed") else "hard_gate_failed" end),
					remaining_human_review_points: ($in.remaining_human_review_points // [])
				}
		' "${path}"
	)"

	if [[ -n ${out_path} ]]; then
		printf '%s\n' "${result}" >"${out_path}"
		echo "wrote ${out_path}"
	else
		printf '%s\n' "${result}"
	fi

	jq -e '.hard_gates_passed == true' <<<"${result}" >/dev/null
}

case "${mode}" in
	validate)
		validate_skill_evals "${skill_dir}"
		;;
	aggregate)
		aggregate_criteria "${criteria_path}"
		;;
	*)
		skill_lab_die "unsupported mode: ${mode}"
		;;
esac
