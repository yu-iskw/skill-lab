# Validate an Agent Skill package against Agent Skills naming/metadata rules
# and Skill Lab structural expectations.
set -euo pipefail

script_dir="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck source=../lib/common.sh
source "${script_dir}/../lib/common.sh"

skill_lab_require_jq

usage() {
	cat <<'EOF'
Usage: skill-lab-validate [--json] <skill-dir>

Validate SKILL.md frontmatter, name/directory equality, description length,
and optional eval JSON structure for a portable Agent Skill package.
EOF
}

json_output=false
skill_dir=""

while [[ $# -gt 0 ]]; do
	case "$1" in
	--json)
		json_output=true
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	-*)
		skill_lab_die "unknown option: $1"
		;;
	*)
		skill_dir="$1"
		shift
		;;
	esac
done

[[ -n ${skill_dir} ]] || {
	usage >&2
	exit 2
}
[[ -d ${skill_dir} ]] || skill_lab_die "not a directory: ${skill_dir}"

skill_dir="$(CDPATH='' cd -- "${skill_dir}" && pwd)"
dir_name="$(basename -- "${skill_dir}")"
skill_md="${skill_dir}/SKILL.md"
findings=()
errors=0

add_finding() {
	local severity="$1"
	local code="$2"
	local message="$3"
	findings+=("$(skill_lab_emit_finding "${severity}" "${code}" "${message}")")
	if [[ ${severity} == error ]]; then
		errors=$((errors + 1))
	fi
}

if [[ ! -f ${skill_md} ]]; then
	add_finding error MISSING_SKILL_MD "SKILL.md is required"
else
	if ! head -n 1 "${skill_md}" | grep -qx -- '---'; then
		add_finding error FRONTMATTER_MISSING "SKILL.md must start with YAML frontmatter"
	else
		name="$(skill_lab_frontmatter_field "${skill_md}" name)"
		description="$(skill_lab_frontmatter_field "${skill_md}" description)"

		if [[ -z ${name} ]]; then
			add_finding error NAME_MISSING "frontmatter field 'name' is required"
		else
			if ! skill_lab_is_valid_skill_name "${name}"; then
				add_finding error NAME_INVALID "name must be 1-64 chars, lowercase alphanumeric with single hyphens: '${name}'"
			fi
			if [[ ${name} != "${dir_name}" ]]; then
				add_finding error NAME_DIR_MISMATCH "name '${name}' must match directory '${dir_name}'"
			fi
		fi

		if [[ -z ${description} ]]; then
			add_finding error DESCRIPTION_MISSING "frontmatter field 'description' is required"
		else
			desc_len=${#description}
			if ((desc_len < 1 || desc_len > 1024)); then
				add_finding error DESCRIPTION_LENGTH "description length must be 1-1024 (got ${desc_len})"
			fi
		fi
	fi
fi

# Forbidden placeholder markers that indicate unfinished generation.
if [[ -f ${skill_md} ]] && grep -Eq 'TODO|FIXME|TBD|<[A-Z_]+>' "${skill_md}"; then
	add_finding warning FORBIDDEN_PLACEHOLDER "SKILL.md contains unfinished placeholder markers"
fi

validate_eval_file() {
	local path="$1"
	local kind="$2"
	skill_lab_json_ok "${path}"

	local cases_expr='(if type=="array" then . else .cases end)'
	if ! jq -e "${cases_expr} | type == \"array\"" "${path}" >/dev/null 2>&1; then
		add_finding error EVAL_CASES_MISSING "${kind}: cases array is required"
		return
	fi

	local dupes
	dupes="$(jq -r "${cases_expr} | map(.id) | group_by(.) | map(select(length>1) | .[0]) | .[]?" "${path}")"
	if [[ -n ${dupes} ]]; then
		while IFS= read -r dup; do
			[[ -z ${dup} ]] && continue
			add_finding error EVAL_DUPLICATE_ID "${kind}: duplicate case id '${dup}'"
		done <<<"${dupes}"
	fi

	local invalid_split
	invalid_split="$(jq -r "${cases_expr}[] | select(.split != null and (.split | IN(\"train\",\"validation\",\"held-out\") | not)) | .id" "${path}")"
	if [[ -n ${invalid_split} ]]; then
		while IFS= read -r cid; do
			[[ -z ${cid} ]] && continue
			add_finding error EVAL_SPLIT_INVALID "${kind}: case '${cid}' has invalid split"
		done <<<"${invalid_split}"
	fi

	if [[ ${kind} == trigger-evals ]]; then
		local missing
		missing="$(jq -r "${cases_expr}[] | select((.id|not) or (.prompt|not) or (.expected.should_trigger|type != \"boolean\")) | .id // \"<missing-id>\"" "${path}")"
		if [[ -n ${missing} ]]; then
			while IFS= read -r cid; do
				[[ -z ${cid} ]] && continue
				add_finding error TRIGGER_CASE_INVALID "trigger case '${cid}' requires id, prompt, expected.should_trigger"
			done <<<"${missing}"
		fi
	fi

	if [[ ${kind} == output-evals ]]; then
		local missing
		missing="$(jq -r "${cases_expr}[] | select((.id|not) or (.prompt|not) or (.assertions|type != \"array\") or ((.assertions|length) < 1)) | .id // \"<missing-id>\"" "${path}")"
		if [[ -n ${missing} ]]; then
			while IFS= read -r cid; do
				[[ -z ${cid} ]] && continue
				add_finding error OUTPUT_CASE_INVALID "output case '${cid}' requires id, prompt, and non-empty assertions"
			done <<<"${missing}"
		fi
	fi
}

if [[ -f ${skill_dir}/evals/trigger-evals.json ]]; then
	validate_eval_file "${skill_dir}/evals/trigger-evals.json" trigger-evals
fi
if [[ -f ${skill_dir}/evals/output-evals.json ]]; then
	validate_eval_file "${skill_dir}/evals/output-evals.json" output-evals
fi

# Check referenced local files mentioned as relative paths under references/
if [[ -d ${skill_dir}/references ]]; then
	while IFS= read -r -d '' ref; do
		:
	done < <(find "${skill_dir}/references" -type f -print0 2>/dev/null || true)
fi

passed=true
if ((errors > 0)); then
	passed=false
fi

if [[ ${json_output} == true ]]; then
	findings_json='[]'
	if ((${#findings[@]} > 0)); then
		findings_json="$(printf '%s\n' "${findings[@]}" | jq -s '.')"
	fi
	jq -nc \
		--arg skill_dir "${skill_dir}" \
		--arg skill_name "${dir_name}" \
		--argjson passed "${passed}" \
		--argjson error_count "${errors}" \
		--argjson findings "${findings_json}" \
		'{skill_dir:$skill_dir, skill_name:$skill_name, passed:$passed, error_count:$error_count, findings:$findings}'
else
	echo "skill-lab-validate: ${dir_name}"
	if ((${#findings[@]} == 0)); then
		echo "OK: no findings"
	else
		printf '%s\n' "${findings[@]}" | jq -r '"\(.severity | ascii_upcase) \(.code): \(.message)"'
	fi
	if [[ ${passed} == true ]]; then
		echo "RESULT: PASS"
	else
		echo "RESULT: FAIL (${errors} error(s))"
	fi
fi

[[ ${passed} == true ]]
