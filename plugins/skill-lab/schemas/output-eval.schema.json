{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/skill-lab/schemas/output-eval.schema.json",
  "title": "Skill Lab Output Evaluation Suite",
  "description": "Output eval suites may be a bare array of cases or an object with a required cases array. Each case requires id, prompt, input_files, assertions, human_review_points, and split. Each assertion requires id, type, and severity.",
  "oneOf": [
    {
      "type": "array",
      "items": {
        "$ref": "#/definitions/case"
      }
    },
    {
      "type": "object",
      "required": ["cases"],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "suite_id": {
          "type": "string"
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/case"
          }
        }
      },
      "additionalProperties": true
    }
  ],
  "definitions": {
    "case": {
      "type": "object",
      "required": [
        "id",
        "prompt",
        "input_files",
        "assertions",
        "human_review_points",
        "split"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "input_files": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "required": ["path"],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "content": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            ]
          }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/assertion"
          }
        },
        "human_review_points": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "split": {
          "type": "string",
          "enum": ["train", "validation", "held-out"]
        }
      },
      "additionalProperties": true
    },
    "assertion": {
      "type": "object",
      "required": ["id", "type", "severity"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": ["hard", "quality", "info"]
        },
        "expected": {},
        "observed": {},
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
