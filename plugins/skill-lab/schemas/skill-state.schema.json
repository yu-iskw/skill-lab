{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/skill-lab/schemas/skill-state.schema.json",
  "title": "Skill Lab Skill State",
  "description": "Mutable state for a Skill Lab skill under evaluation. Required fields: skill_name, current_checkpoint, and checkpoints. Each checkpoint requires id, path, score, hard_gates_passed, and created_at.",
  "type": "object",
  "required": [
    "skill_name",
    "current_checkpoint",
    "checkpoints"
  ],
  "properties": {
    "skill_name": {
      "type": "string",
      "minLength": 1
    },
    "current_checkpoint": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/checkpoint"
      }
    }
  },
  "additionalProperties": true,
  "definitions": {
    "checkpoint": {
      "type": "object",
      "required": [
        "id",
        "path",
        "score",
        "hard_gates_passed",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hard_gates_passed": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    }
  }
}
